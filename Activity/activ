import numpy as np
import matplotlib.pyplot as plt
 
# x-values
x = np.linspace(-10, 10, 400)
 
# Function and its derivatives
f = x**2
f_prime = 2 * x
f_double_prime = np.full_like(x, 2)
 
# Create 3 graphs side by side
fig, axes = plt.subplots(1, 3, figsize=(15, 5))
 
# -----------------------------
# 1. Original Function
# -----------------------------
axes[0].plot(x, f, label=r'$f(x) = x^2$')
axes[0].set_title('Original Function')
axes[0].set_xlabel('x')
axes[0].set_ylabel('f(x)')
axes[0].legend()
axes[0].grid(True)
 
# -----------------------------
# 2. First Derivative
# -----------------------------
axes[1].plot(x, f_prime, label=r"$f'(x) = 2x$")
axes[1].set_title('First Derivative')
axes[1].set_xlabel('x')
axes[1].set_ylabel("f'(x)")
axes[1].legend()
axes[1].grid(True)
 
# -----------------------------
# 3. Second Derivative
# -----------------------------
axes[2].plot(x, f_double_prime, label=r"$f''(x) = 2$")
axes[2].set_title('Second Derivative')
axes[2].set_xlabel('x')
axes[2].set_ylabel("f''(x)")
axes[2].legend()
axes[2].grid(True)
 
# Make the spacing look clean
plt.tight_layout()
 
# Display the graphs
plt.show()