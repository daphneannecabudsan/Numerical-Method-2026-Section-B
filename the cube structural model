# SECTION 10: EXCEL OUTPUT (Rev. 2 — new sheet structure)
# ============================================================

def write_excel_output(U, R, member_forces, member_data, node_dofs, restrained, active):
    wb = Workbook()
    hdr_font    = Font(bold=True, color="FFFFFF", size=10)
    hdr_fill    = PatternFill(start_color="1F4E79", end_color="1F4E79", fill_type="solid")
    hdr_align   = Alignment(horizontal="center", vertical="center", wrap_text=True)
    thin_border = Border(
        left=Side(style="thin"), right=Side(style="thin"),
        top=Side(style="thin"), bottom=Side(style="thin"),
    )
    num_fmt_6 = "0.000000E+00"
    num_fmt_4 = "0.0000E+00"

    def style_header(ws, row, ncols):
        for col in range(1, ncols + 1):
            cell = ws.cell(row=row, column=col)
            cell.font = hdr_font
            cell.fill = hdr_fill
            cell.alignment = hdr_align
            cell.border = thin_border

    def write_row(ws, row, data, fmt=None):
        for col, val in enumerate(data, 1):
            cell = ws.cell(row=row, column=col, value=val)
            cell.border = thin_border
            cell.alignment = Alignment(horizontal="center")
            if fmt and isinstance(val, float):
                cell.number_format = fmt

    def color_fill(hex_color):
        return PatternFill(start_color=hex_color.replace("#", ""),
                           end_color=hex_color.replace("#", ""), fill_type="solid")

    # --- Sheet: Nodes ---
    ws = wb.active
    ws.title = "Nodes"
    hdrs = ["Node", "X (m)", "Y (m)", "Z (m)", "Support", "Color Code"]
    for c, h in enumerate(hdrs, 1):
        ws.cell(row=1, column=c, value=h)
    style_header(ws, 1, len(hdrs))
    for i, n in enumerate(NODES, 2):
        c = NODES[n]
        sup = "Pinned" if n in PINNED_NODES else "Free"
        clr = C_PIN if n in PINNED_NODES else C_FREE
        write_row(ws, i, [n, c[0], c[1], c[2], sup, clr])
        ws.cell(row=i, column=6).fill = color_fill(clr)

    # --- Sheet: Members ---
    ws = wb.create_sheet("Members")
    hdrs = ["Member", "i-Node", "j-Node", "Type", "Beta (deg)",
            "Release", "Color Code"]
    for c, h in enumerate(hdrs, 1):
        ws.cell(row=1, column=c, value=h)
    style_header(ws, 1, len(hdrs))
    type_colors = {"Column": C_COL, "Beam": C_BEAM, "Ground Beam": C_GROUND}
    for i, m in enumerate(MEMBERS, 2):
        ni, nj = MEMBERS[m]
        rel = "MZ_i + MZ_j" if m in RELEASED_MEMBERS else "None"
        clr = type_colors[MEMBER_TYPE[m]]
        write_row(ws, i, [m, ni, nj, MEMBER_TYPE[m], BETA[m], rel, clr])
        ws.cell(row=i, column=7).fill = color_fill(clr)

    # --- Sheet: DOF ---
    ws = wb.create_sheet("DOF")
    hdrs = ["DOF #", "Node", "DOF Type", "Restrained?"]
    for c, h in enumerate(hdrs, 1):
        ws.cell(row=1, column=c, value=h)
    style_header(ws, 1, len(hdrs))
    row = 2
    for n in NODES:
        dofs = node_dofs[n]
        for k, lbl in enumerate(DOF_LABELS):
            is_r = "Yes" if dofs[k] in restrained else "No"
            write_row(ws, row, [dofs[k] + 1, n, lbl, is_r])
            if is_r == "Yes":
                ws.cell(row=row, column=4).fill = color_fill("#ffe0e0")
            row += 1

    # --- Sheet: Supports ---
    ws = wb.create_sheet("Supports")
    hdrs = ["Node", "UX", "UY", "UZ", "RX", "RY", "RZ"]
    for c, h in enumerate(hdrs, 1):
        ws.cell(row=1, column=c, value=h)
    style_header(ws, 1, len(hdrs))
    for i, n in enumerate(PINNED_NODES, 2):
        dofs = node_dofs[n]
        statuses = []
        for k in range(6):
            statuses.append("Fixed" if dofs[k] in restrained else "Free")
        write_row(ws, i, [n] + statuses)
        for k in range(3):
            ws.cell(row=i, column=k + 2).fill = color_fill("#ffe0e0")

    # --- Sheet: Releases ---
    ws = wb.create_sheet("Releases")
    hdrs = ["Member", "i-Node", "j-Node", "Released DOF", "End"]
    for c, h in enumerate(hdrs, 1):
        ws.cell(row=1, column=c, value=h)
    style_header(ws, 1, len(hdrs))
    row = 2
    for m in RELEASED_MEMBERS:
        ni, nj = MEMBERS[m]
        write_row(ws, row, [m, ni, nj, "MZ (Local DOF 6)", "i-end"])
        ws.cell(row=row, column=4).fill = color_fill("#ffe0e0")
        row += 1
        write_row(ws, row, [m, ni, nj, "MZ (Local DOF 12)", "j-end"])
        ws.cell(row=row, column=4).fill = color_fill("#ffe0e0")
        row += 1

    # --- Sheet: Colors ---
    ws = wb.create_sheet("Colors")
    hdrs = ["Element", "Color Code", "Hex"]
    for c, h in enumerate(hdrs, 1):
        ws.cell(row=1, column=c, value=h)
    style_header(ws, 1, len(hdrs))
    color_legend = [
        ("Columns",        C_COL),
        ("Top Beams",      C_BEAM),
        ("Ground Beams",   C_GROUND),
        ("Pinned Supports", C_PIN),
        ("MZ Releases",    C_REL),
        ("Free Nodes",     C_FREE),
        ("Applied Loads",  C_LOAD),
        ("Background",     C_BG),
    ]
    for i, (name, hex_val) in enumerate(color_legend, 2):
        write_row(ws, i, [name, "", hex_val])
        ws.cell(row=i, column=2).fill = color_fill(hex_val)

    filepath = "cube_solver_output.xlsx"
    wb.save(filepath)
    print(f"  Saved: {filepath}")

# ============================================================
# SECTION 11: MAIN EXECUTION
# ============================================================

if __name__ == "__main__":
    print("=" * 60)
    print(" CUBE STRUCTURAL SOLVER — Rev. 2")
    print(" Direct Stiffness Method | 3D Frame")
    print("=" * 60)

    print("\n[1] Building DOF system...")
    node_dofs, restrained, active = build_dof_system()
    print(f"  Total DOF:  {TOTAL_DOF}")
    print(f"  Restrained: {len(restrained)}  -> {restrained}")
    print(f"  Active:     {len(active)}")

    print("\n[2] Computing member stiffness matrices...")
    member_data = {}
    for m in MEMBERS:
        ni, nj = MEMBERS[m]
        T, L, lam = build_transformation(NODES[ni], NODES[nj], BETA[m])
        k_local_orig = element_stiffness_local(L)

        if m in RELEASED_MEMBERS:
            k_rel, active_loc, released_loc, k_cond = apply_releases(
                k_local_orig, [5, 11]
            )
        else:
            k_rel = k_local_orig.copy()
            active_loc = list(range(12))
            released_loc = []
            k_cond = k_local_orig.copy()

        k_global = T.T @ k_rel @ T

        member_data[m] = {
            "ni": ni, "nj": nj, "L": L, "T": T, "lam": lam,
            "k_original": k_local_orig, "k_global": k_global,
            "k_condensed": k_cond,
            "active_local": active_loc, "released_local": released_loc,
            "released": m in RELEASED_MEMBERS,
            "global_dofs": node_dofs[ni] + node_dofs[nj],
        }
        rel_str = f"  Released: {released_loc}" if released_loc else ""
        print(f"  M{m:2d} ({ni}->{nj})  L={L:.4f}m  "
              f"beta={BETA[m]:3d}  [{MEMBER_TYPE[m]}]{rel_str}")

    print("\n[3] Assembling global stiffness matrix...")
    K = assemble_global_K(member_data, node_dofs)
    print(f"  K shape: {K.shape}  max diag: {np.max(np.diag(K)):.4e}")

    print("\n[4] Building load vector...")
    F = np.zeros(TOTAL_DOF)
    for n, lv in LOADS.items():
        dofs = node_dofs[n]
        for k in range(6):
            F[dofs[k]] += lv[k]
    app_fx = sum(LOADS[n][0] for n in LOADS)
    app_fy = sum(LOADS[n][1] for n in LOADS)
    app_fz = sum(LOADS[n][2] for n in LOADS)
    print(f"  Applied: FX={app_fx:.0f} N  FY={app_fy:.0f} N  FZ={app_fz:.0f} N")

    print("\n[5] Solving system...")
    U, R = solve_system(K, F, restrained, active)

    print("\n[6] Nodal Displacements:")
    print(f"  {'Node':>4s}  {'UX (m)':>12s}  {'UY (m)':>12s}  {'UZ (m)':>12s}  "
          f"{'RX (rad)':>12s}  {'RY (rad)':>12s}  {'RZ (rad)':>12s}")
    for n in NODES:
        d = node_dofs[n]
        vals = [U[d[k]] for k in range(6)]
        print(f"  {n:4d}  {vals[0]:12.6e}  {vals[1]:12.6e}  {vals[2]:12.6e}  "
              f"{vals[3]:12.6e}  {vals[4]:12.6e}  {vals[5]:12.6e}")

    print("\n[7] Support Reactions:")
    print(f"  {'Node':>4s}  {'FX (N)':>12s}  {'FY (N)':>12s}  {'FZ (N)':>12s}  "
          f"{'MX (Nm)':>12s}  {'MY (Nm)':>12s}  {'MZ (Nm)':>12s}")
    for n in PINNED_NODES:
        d = node_dofs[n]
        vals = [R[d[k]] for k in range(6)]
        print(f"  {n:4d}  {vals[0]:12.4f}  {vals[1]:12.4f}  {vals[2]:12.4f}  "
              f"{vals[3]:12.4f}  {vals[4]:12.4f}  {vals[5]:12.4f}")

    sum_fx = sum(R[node_dofs[n][0]] for n in PINNED_NODES)
    sum_fy = sum(R[node_dofs[n][1]] for n in PINNED_NODES)
    sum_fz = sum(R[node_dofs[n][2]] for n in PINNED_NODES)
    print(f"\n  Equilibrium check:")
    print(f"    Sum R_FX + Sum P_FX = {sum_fx + app_fx:.6f} N")
    print(f"    Sum R_FY + Sum P_FY = {sum_fy + app_fy:.6f} N")
    print(f"    Sum R_FZ + Sum P_FZ = {sum_fz + app_fz:.6f} N")

    print("\n[8] Member End Forces (Local Axes):")
    member_forces = compute_member_forces(member_data, U)
    print(f"  {'Mbr':>4s}  {'End':>3s}  {'Fx (N)':>12s}  {'Fy (N)':>12s}  "
          f"{'Fz (N)':>12s}  {'Mx (Nm)':>12s}  {'My (Nm)':>12s}  {'Mz (Nm)':>12s}")
    for m in sorted(member_forces.keys()):
        f = member_forces[m]
        print(f"  {m:4d}    i   {f[0]:12.4f}  {f[1]:12.4f}  {f[2]:12.4f}  "
              f"{f[3]:12.4f}  {f[4]:12.4f}  {f[5]:12.4f}")
        print(f"  {'':>4s}    j   {f[6]:12.4f}  {f[7]:12.4f}  {f[8]:12.4f}  "
              f"{f[9]:12.4f}  {f[10]:12.4f}  {f[11]:12.4f}")
        if m in RELEASED_MEMBERS:
            tol = 1e-6
            mz_i, mz_j = abs(f[5]), abs(f[11])
            print(f"         Release check: Mz_i={'OK' if mz_i < tol else f'WARN ({mz_i:.4f})'}"
                  f"  Mz_j={'OK' if mz_j < tol else f'WARN ({mz_j:.4f})'}")

    print("\n[9] Generating structural diagram...")
    plot_structural_diagram(member_data, U, R, node_dofs, restrained, active)

    print("\n[10] Writing Excel output...")
    write_excel_output(U, R, member_forces, member_data, node_dofs, restrained, active)

    print("\n" + "=" * 60)
    print(" SOLVER COMPLETE — Rev. 2")
    print("=" * 60)
